# Non-secret production paths and origins. Use absolute paths outside the repository.
MUSEECHO_DATA_ROOT=
MUSEECHO_AUDIO_KEK_FILE=
MUSEECHO_TRUSTED_ORIGINS=https://localhost:8443,https://127.0.0.1:8443
MUSEECHO_PUBLIC_ORIGIN=https://localhost:8443
# Only internal reverse proxy networks may supply X-MuseEcho-Client-IP.
MUSEECHO_TRUSTED_PROXY_CIDRS=172.16.0.0/12

# Transactional mail for registration and password reset. In production, mount the
# password as a read-only file outside the repository and set PASSWORD_FILE only.
# The current SMTP adapter uses STARTTLS on port 587.
MUSEECHO_SMTP_HOST=
MUSEECHO_SMTP_PORT=587
MUSEECHO_SMTP_USER=
MUSEECHO_SMTP_PASSWORD=
MUSEECHO_SMTP_PASSWORD_FILE=
MUSEECHO_SMTP_SENDER=

# Preferred for Tencent Cloud personal verified accounts. Keep both credentials
# in separate read-only files outside the repository. Do not also configure SMTP.
MUSEECHO_TENCENT_SES_REGION=
MUSEECHO_TENCENT_SES_SENDER=
MUSEECHO_TENCENT_SES_SECRET_ID_FILE=
MUSEECHO_TENCENT_SES_SECRET_KEY_FILE=
MUSEECHO_TENCENT_SES_VERIFY_TEMPLATE_ID=
MUSEECHO_TENCENT_SES_RESET_TEMPLATE_ID=

# Host backup scripts use these non-secret settings. The age identity file is
# restore-only and must remain outside the repository.
MUSEECHO_BACKUP_RETENTION_DAYS=30
MUSEECHO_BACKUP_AGE_RECIPIENT=
MUSEECHO_BACKUP_AGE_IDENTITY_FILE=

# Development profile only. Production is fixed to host /etc/museecho/secrets.
MUSEECHO_SECRETS_DIR=

# Optional Debian package mirror used only while building the app image.
MUSEECHO_DEBIAN_MIRROR=https://deb.debian.org/debian

# Optional non-secret provider configuration. Never place an API key in this file.
MUSEECHO_PROVIDER_BASE_URL=
MUSEECHO_PROVIDER_MODEL=

# Container deployments may select an absolute, read-only mounted file outside the repository.
MUSEECHO_PROVIDER_SECRET_FILE=
